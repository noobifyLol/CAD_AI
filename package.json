{
  "name": "cad-ai-generator",
  "version": "1.0.0",
  "description": "Groq-first FeatureScript generator with FeatureScript docs grounding",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run -s test:validator && npm run -s test:plan && npm run -s test:fallback && npm run -s test:deepcad && npm run -s test:deepcad-e2e",
    "test:guaranteed": "node test.js",
    "test:fallback": "node scripts/prompt_fallback_check.mjs",
    "test:validator": "node scripts/validator_regression.mjs",
    "test:plan": "node scripts/plan_compiler_check.mjs",
    "test:deepcad": "node scripts/deepcad_compiler_check.mjs",
    "test:deepcad-e2e": "node scripts/deepcad_e2e_check.mjs",
    "test:deepcad-live": "node scripts/deepcad_live_check.mjs",
    "test:sim": "node scripts/sim_check.mjs",
    "sim:fetch-std": "bash fs_sim/fetch_std.sh",
    "sim:run": "node scripts/run_python.mjs -m fs_sim.run",
    "test:onshape": "node scripts/onshape_compile_check.mjs",
    "test:e2e": "node scripts/e2e_generate.mjs",
    "seed:knowledge": "node scripts/seedCadKnowledge.js",
    "import:cad-knowledge": "node scripts/importCadKnowledgeCsv.js",
    "import:cad-pruning": "node scripts/importCadKnowledgeCsv.js ./data/cadPruningTable.csv",
    "import:dataset-summaries": "node scripts/ingest_cad_mllm_dataset.js",
    "import:cadfs": "node scripts/import_cadfs.mjs",
    "model:serve": "node scripts/run_python.mjs .venv model_service/cadfs_server.py",
    "model:check": "node scripts/check_model_backend.mjs",
    "deepcad:serve": "node scripts/run_python.mjs .text2cad/venv hf_space/run_local.py",
    "deepcad:modal-secret": "node scripts/deepcad_modal_secret.mjs",
    "deepcad:deploy": "node scripts/run_python.mjs .text2cad/venv -m modal deploy hf_space/modal_app.py",
    "model:deploy": "node scripts/run_python.mjs .venv -m modal deploy model_service/modal_app.py",
    "prune:cad-memory": "node scripts/pruneCadMemory.js",
    "db:learning-report": "node scripts/dbLearningReport.js",
    "build:research-import": "node scripts/build_research_import_artifacts.js",
    "build:failure-corpus": "node scripts/build_failure_corpus.js",
    "smoke:generate": "node scripts/run_smoke_tests.js /generate",
    "regression:corpus": "node scripts/run_smoke_tests.js /generate",
    "train:adaptive": "node scripts/train_adaptive_network.js data/adaptive_training.jsonl"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
