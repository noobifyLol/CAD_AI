# CAD AI settings. Copy this file to .env (npm run setup does it for you) and fill in ONE AI key.
# Nothing in .env is ever committed to git.

# --- AI that writes the parts: use at least one (both are free) -------------------------
# Google Gemini (recommended: bigger limits). Key: https://aistudio.google.com/apikey
ALT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ALT_LLM_MODEL=gemini-2.5-flash
ALT_LLM_API_KEY=

# Groq (backup, or use alone). Key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional -----------------------------------------------------------------------------
# Which steps use Gemini (its free tier allows few requests per day; the rest use Groq)
# ALT_LLM_STAGES=generation,repair,planning
# Gemini thinking while writing code: none, low, medium (default), high
# ALT_LLM_CODE_REASONING_EFFORT=medium
# Groq tokens-per-minute limit of your account (prompt + answer must fit in it)
# GROQ_TPM_LIMIT=8000

# Accounts and history (Supabase project URL and keys)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# The port the site runs on (default 10000)
# PORT=10000
