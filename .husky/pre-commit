#!/usr/bin/env bash
# precommit: scan .fs files for forbidden patterns
set -e

FORBIDDEN_PATTERNS=(
  "is\s\+(number|string|boolean)"
  "\.length\b"
  "opCylinder\s*\([^)]*,[^{}]*\)"
  "qSketchRegion\s*\(\s*[a-zA-Z_$][a-zA-Z0-9_$]*\s*\)"
)

EXIT_CODE=0
for f in $(git diff --cached --name-only --diff-filter=ACM | grep '\.fs$' || true); do
  for p in "${FORBIDDEN_PATTERNS[@]}"; do
    if grep -nE "$p" "$f" >/dev/null; then
      echo "ERROR: Forbidden pattern '$p' found in $f"
      EXIT_CODE=1
    fi
  done
done

if [ $EXIT_CODE -ne 0 ]; then
  echo "Commit rejected: sanitize your .fs files."
  exit $EXIT_CODE
fi
